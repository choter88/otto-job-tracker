{
  "name": "rest-express",
  "version": "1.9.19",
  "type": "module",
  "main": "desktop/main.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/choter88/otto-job-tracker.git"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "lint": "eslint client",
    "build:tablet": "vite build --config vite.tablet.config.ts",
    "build": "vite build && npm run build:tablet && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --sourcemap --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "desktop": "electron .",
    "pack:desktop": "npm run build && electron-builder --dir",
    "dist:desktop": "npm run build && electron-builder",
    "release:mac": "bash scripts/release-mac.sh",
    "release:win": "node scripts/release-win.js",
    "release:upload": "node scripts/release-upload.js",
    "build:mac": "bash scripts/build-mac-local.sh",
    "build:win": "node scripts/build-win-local.js",
    "check": "tsc",
    "test:no-offline-outbox": "node --import tsx --test tests/no-offline-outbox.test.ts",
    "test:migration-import": "node --import tsx --test tests/migration-import.test.ts",
    "test:onboarding-helpers": "node --import tsx --test tests/onboarding-helpers.test.ts",
    "test:settings-merge": "node --import tsx --test tests/settings-merge.test.ts",
    "test:snapshot-onboarding-stamp": "node --import tsx --test tests/snapshot-onboarding-stamp.test.ts",
    "test:custom-columns-helper": "node --import tsx --test tests/custom-columns-helper.test.ts",
    "test:wizard-flow": "node --import tsx --test tests/wizard-flow.test.ts",
    "test:notification-rules-no-sms": "node --import tsx --test tests/notification-rules-no-sms.test.ts",
    "test:setup-wizard": "npm run test:onboarding-helpers && npm run test:custom-columns-helper && npm run test:settings-merge && npm run test:snapshot-onboarding-stamp && npm run test:wizard-flow && npm run test:notification-rules-no-sms",
    "test:lifecycle-helpers": "node --import tsx --test tests/lifecycle-helpers.test.ts",
    "test:labs-copy": "node --import tsx --test tests/labs-copy.test.ts",
    "test:restore-stamp": "node --import tsx --test tests/restore-stamp.test.ts",
    "test:ui-redesign": "npm run test:lifecycle-helpers && npm run test:labs-copy && npm run test:restore-stamp",
    "test:order-sheet-parser": "node --import tsx --test tests/order-sheet-parser.test.ts",
    "test:order-sheet-parser-crystal-pm": "node --import tsx --test tests/order-sheet-parser-crystal-pm.test.ts",
    "test:order-sheet-watcher": "node --import tsx --test tests/order-sheet-watcher.test.ts",
    "test:order-sheet-watchers": "node --import tsx --test tests/order-sheet-watchers.test.ts",
    "test:order-sheet-attachments": "node --import tsx --test tests/order-sheet-attachments.test.ts",
    "test:backup-attachments": "node --import tsx --test tests/backup-attachments.test.ts",
    "test:job-attachments": "node --import tsx --test tests/job-attachments.test.ts",
    "test:order-sheet-learning": "node --import tsx --test tests/order-sheet-learning.test.ts",
    "test:order-sheets": "npm run test:order-sheet-parser && npm run test:order-sheet-parser-crystal-pm && npm run test:order-sheet-watcher && npm run test:order-sheet-watchers && npm run test:order-sheet-attachments && npm run test:backup-attachments && npm run test:job-attachments && npm run test:order-sheet-learning",
    "test:archive-tray-number": "node --import tsx --test tests/archive-tray-number.test.ts",
    "test:always-on-host": "node --import tsx --test tests/always-on-host.test.ts",
    "test:always-on-packaging": "node --import tsx --test tests/always-on-packaging.test.ts",
    "test:always-on": "npm run test:always-on-host && npm run test:always-on-packaging",
    "test:update-prompt": "node --import tsx --test tests/update-prompt.test.ts",
    "test:reconnect": "node --import tsx --test tests/reconnect.test.ts",
    "test:login-ids": "node --import tsx --test tests/login-ids.test.ts",
    "test:host-probe": "node --import tsx --test tests/host-probe.test.ts",
    "test:onboarding-role": "node --import tsx --test tests/onboarding-role.test.ts",
    "test:reset-config": "node --import tsx --test tests/reset-config.test.ts",
    "test:today-defaults": "node --import tsx --test tests/today-defaults.test.ts",
    "test:today-activity": "node --import tsx --test tests/today-activity.test.ts",
    "test:job-events-foundation": "node --import tsx --test tests/job-events-foundation.test.ts",
    "test:migrate-existing-db": "node --import tsx --test tests/migrate-existing-db.test.ts",
    "test:job-labels": "node --import tsx --test tests/job-labels.test.ts",
    "test:snooze-predicate": "node --import tsx --test tests/snooze-predicate.test.ts",
    "test:today-flag": "node --import tsx --test tests/today-flag.test.ts",
    "test:today-telemetry-egress": "node --import tsx --test tests/today-telemetry-egress.test.ts",
    "test:job-events-storage": "node --import tsx --test tests/job-events-storage.test.ts",
    "test:updatejob-dualwrite": "node --import tsx --test tests/updatejob-dualwrite.test.ts",
    "test:overdue-dedupe": "node --import tsx --test tests/overdue-dedupe.test.ts",
    "test:activity-feed-events": "node --import tsx --test tests/activity-feed-events.test.ts",
    "test:search-by-patient": "node --import tsx --test tests/search-by-patient.test.ts",
    "test:chase-attempts": "node --import tsx --test tests/chase-attempts.test.ts",
    "test:today-config-no-stats": "node --import tsx --test tests/today-config-no-stats.test.ts",
    "test:snooze-presets": "node --import tsx --test tests/snooze-presets.test.ts",
    "test:attempt-summary": "node --import tsx --test tests/attempt-summary.test.ts",
    "test:today-holder-groups": "node --import tsx --test tests/today-holder-groups.test.ts",
    "test:queue-sort-worst-first": "node --import tsx --test tests/queue-sort-worst-first.test.ts",
    "test:today-telemetry": "node --import tsx --test tests/today-telemetry.test.ts",
    "test:today-copy-lint": "node --import tsx --test tests/today-copy-lint.test.ts",
    "test:timestamp-iso-shape": "node --import tsx --test tests/timestamp-iso-shape.test.ts",
    "test:next-status": "node --import tsx --test tests/next-status.test.ts",
    "test:status-from-search": "node --import tsx --test tests/status-from-search.test.ts",
    "test:audit-retention": "node --import tsx --test tests/audit-retention.test.ts",
    "test:audit-preserve": "node --import tsx --test tests/audit-preserve.test.ts",
    "test:backup-audit": "node --import tsx --test tests/backup-audit.test.ts",
    "test:all": "npm run test:no-offline-outbox && npm run test:migration-import && npm run test:archive-tray-number && npm run test:setup-wizard && npm run test:ui-redesign && npm run test:order-sheets && npm run test:always-on && npm run test:update-prompt && npm run test:reconnect && npm run test:login-ids && npm run test:host-probe && npm run test:onboarding-role && npm run test:reset-config && npm run test:today-defaults && npm run test:today-activity && npm run test:job-events-foundation && npm run test:migrate-existing-db && npm run test:job-labels && npm run test:snooze-predicate && npm run test:today-flag && npm run test:today-telemetry-egress && npm run test:job-events-storage && npm run test:updatejob-dualwrite && npm run test:overdue-dedupe && npm run test:activity-feed-events && npm run test:search-by-patient && npm run test:chase-attempts && npm run test:today-config-no-stats && npm run test:snooze-presets && npm run test:attempt-summary && npm run test:today-holder-groups && npm run test:queue-sort-worst-first && npm run test:today-telemetry && npm run test:today-copy-lint && npm run test:timestamp-iso-shape && npm run test:next-status && npm run test:status-from-search && npm run test:audit-retention && npm run test:audit-preserve && npm run test:backup-audit",
    "db:push": "drizzle-kit push"
  },
  "build": {
    "appId": "com.ottojobtracker.desktop",
    "productName": "Otto Tracker",
    "publish": {
      "provider": "github",
      "owner": "choter88",
      "repo": "otto-job-tracker"
    },
    "protocols": [
      {
        "name": "Otto Tracker Activation",
        "schemes": [
          "otto",
          "otto-desktop"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "otto-license",
        "name": "Otto Tracker License",
        "description": "Otto Tracker license file"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "!dist/**/*.map",
      "desktop/**",
      "!desktop/lib/update-token.js",
      "desktop/lib/update-token.js",
      "server/migrations/**",
      "node_modules/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "otto-tracker-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": {
        "teamId": "U2QJ2G4PX5"
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "otto-tracker-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-aspect-ratio": "^1.1.3",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-hover-card": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-menubar": "^1.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@sentry/electron": "^7.10.0",
    "@sentry/react": "^10.45.0",
    "@tanstack/react-query": "^5.60.5",
    "better-sqlite3": "^11.10.0",
    "better-sqlite3-session-store": "^0.1.0",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^6.1.0",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.39.1",
    "drizzle-zod": "^0.7.0",
    "electron-updater": "^6.8.3",
    "embla-carousel-react": "^8.6.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.453.0",
    "nanoid": "^5.1.6",
    "next-themes": "^0.4.6",
    "node-cron": "^4.2.1",
    "openai": "^6.8.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.55.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.15.2",
    "selfsigned": "^2.4.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "twilio": "^5.10.2",
    "unpdf": "^1.6.2",
    "vaul": "^1.1.2",
    "wouter": "^3.3.5",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "20.16.11",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.4",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "5.6.3",
    "vite": "^5.4.20"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  }
}
